# Copy to .env and change every value. .env is git-ignored.
# Generate strong values with:  openssl rand -base64 24 | tr -d '/+='

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=change-me-admin
AUDITOR_DB_RO_PASSWORD=change-me-readonly
AUDITOR_STATE_DB_PASSWORD=change-me-state
AUDITOR_PAYMENTS_DB_PASSWORD=change-me-payments

# --- Authentication: one API key per person, "id:role[+role]:key", comma-separated.
#     Roles: clerk (upload, key in), analyst (map lines, reconcile contracts), approver (pay), auditor (audit log).
#     Generate keys with: openssl rand -hex 24      (prod rejects keys < 24 chars or containing "change-me")
AUDITOR_API_KEYS=clerk.bea:clerk:change-me-clerk-key-0001,ana:analyst:change-me-analyst-key-02,ap.manager:approver:change-me-approver-key-3,ian:auditor:change-me-auditor-key-004

# --- API ---
AUDITOR_ENV=dev                  # dev | test | prod   (prod disables /docs, forbids SQLite)
AUDITOR_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
AUDITOR_LOG_FORMAT=console       # json | console     (the container always uses json)
AUDITOR_NEAR_DUPLICATE_WINDOW_DAYS=30

# --- LLM (optional). Leave credentials empty to run fully degraded:
#     humans key invoices in, explanations use templates, contracts report UNREADABLE.
AUDITOR_LLM_PROVIDER=anthropic           # anthropic | openai_compatible

# anthropic: direct Claude API
ANTHROPIC_API_KEY=

# openai_compatible: any /chat/completions endpoint (OpenRouter, api.airforce, vLLM, Ollama, ...)
#   list available model IDs:  curl -s $AUDITOR_LLM_BASE_URL/models -H "Authorization: Bearer $AUDITOR_LLM_API_KEY"
AUDITOR_LLM_BASE_URL=
AUDITOR_LLM_API_KEY=
AUDITOR_LLM_JSON_MODE=json_schema        # json_schema | json_object | none   (downgrade if the endpoint rejects it)
AUDITOR_LLM_PDF_MODE=text                # text (sends the PDF text layer; works everywhere) | file
AUDITOR_LLM_MIN_INTERVAL_S=0             # e.g. 61 for a 1-request-per-minute free tier
AUDITOR_LLM_TIMEOUT_S=60

# Model IDs are provider-specific. Set BOTH when switching providers.
AUDITOR_LLM_PARSER_MODEL=claude-sonnet-5-5
AUDITOR_LLM_EXPLAINER_MODEL=claude-haiku-5-5

# --- Local runs outside Docker (uvicorn on your machine) ---
AUDITOR_LEDGER_BACKEND=sqlite    # sqlite | postgres
AUDITOR_CHECKPOINTER=memory      # memory | postgres  (prod requires postgres)
# AUDITOR_DATABASE_URL=postgresql://auditor_ro:change-me-readonly@localhost:5432/erp

# --- Tests: enables the Postgres half of the suite (superuser DSN) ---
# AUDITOR_TEST_DATABASE_URL=postgresql://erp_admin:change-me-admin@localhost:5432/postgres
